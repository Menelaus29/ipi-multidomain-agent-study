# Copy this file to your .env and fill in real values there.
# You may use your own models and your own API keys. I use these freebies because I'm broke :(.

# Groq
# Get a key at https://console.groq.com
GROQ_API_KEY=

# Google AI Studio / Gemini Developer API 
# GCP_LOCATION block below — this is the free Developer API path, not Vertex.
GOOGLE_API_KEY=

# Cohere Trial key (native AgentDojo support)
CO_API_KEY=
